# ==========================================
# ApiForge Environment Variables Configuration
# ==========================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://apiforge:apiforge_secret_pass@localhost:5432/apiforge_dev?schema=public"
POSTGRES_USER="apiforge"
POSTGRES_PASSWORD="apiforge_secret_pass"
POSTGRES_DB="apiforge_dev"
POSTGRES_PORT=5432

# Redis & BullMQ Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis_secret_pass"

# NestJS Server Configuration
PORT=4000
NODE_ENV="development"
API_PREFIX="api/v1"
CORS_ORIGIN="http://localhost:3000"

# Authentication & Security
JWT_ACCESS_SECRET="apiforge_dev_access_secret_key_minimum_32_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="apiforge_dev_refresh_secret_key_minimum_32_characters_long"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_DOMAIN="localhost"

# Local Storage Vault Configuration
STORAGE_ROOT="./storage"
STORAGE_EXPORTS_DIR="./storage/exports"
STORAGE_UPLOADS_DIR="./storage/uploads"
DOWNLOAD_TOKEN_SECRET="apiforge_dev_download_secret_key_minimum_32_chars"

# Next.js Frontend Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
INTERNAL_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
